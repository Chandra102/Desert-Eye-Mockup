    attr="CartoDB", name="Labels", overlay=True
).add_to(m)

# Layer Feature Groups
grid_group = FeatureGroup(name="🌐 Regional Micro-Grid (25x25)", show=True)
farm_group = FeatureGroup(name="🚜 Registered Farm Plots (Live Cadastral)", show=True)

# Generate Live Regional Risk Grid
GRID_SIZE = 25
lats = np.linspace(25.68, 25.82, GRID_SIZE + 1)
lons = np.linspace(71.32, 71.50, GRID_SIZE + 1)

base_temp, base_hum = get_live_weather_telemetry(center_lat, center_lon)

for i in range(GRID_SIZE):
    for j in range(GRID_SIZE):
        poly = Polygon([
            (lons[j], lats[i]), (lons[j+1], lats[i]), 
            (lons[j+1], lats[i+1]), (lons[j], lats[i+1])
        ])
        
        c_lat, c_lon = poly.centroid.y, poly.centroid.x
        cell_ndvi = satellite_engine.get_live_ndvi(c_lat, c_lon)
        
        risk_prob = ml_model.predict_proba([[cell_ndvi, base_temp, base_hum]])[0][1]
        color = "#FF0055" if risk_prob > 0.50 else ("#FFB703" if risk_prob > 0.20 else "#00F5D4")
        
        popup_html = f"""
        <div style="font-family: Arial; width: 220px;">
            <h4 style="margin:0;">Sub-Zone Z-{i+1:02d}:{j+1:02d}</h4>
            <span style="font-size:10px; color:#555;">Spatial Res: ~600m x 600m</span>
            <hr style="border:0.5px solid #ccc; margin:5px 0;">
            <b>Live Satellite NDVI:</b> {cell_ndvi}<br>
            <b>Live Temp/Humidity:</b> {base_temp}°C | {base_hum}%<br>
            <b>Outbreak Risk:</b> <b style="color:{color};">{int(risk_prob*100)}%</b>
        </div>
        """
        
        folium.GeoJson(
            poly,
            style_function=lambda x, col=color: {
                'fillColor': col, 'color': '#ffffff', 'weight': 0.4, 'fillOpacity': 0.3
            },
            popup=folium.Popup(popup_html, max_width=240)
        ).add_to(grid_group)

# Render Registered Farm Parcels
for idx, (geom_id, row) in enumerate(gdf_parcels.iterrows()):
